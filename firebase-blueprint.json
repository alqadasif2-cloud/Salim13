{
  "entities": {
    "CommunityUser": {
      "title": "CommunityUser",
      "description": "Registered user, moderator, or owner profile and credentials.",
      "type": "object",
      "properties": {
        "id": { "type": "number", "description": "Numeric unique user identifier" },
        "username": { "type": "string", "description": "Unique login username" },
        "displayName": { "type": "string", "description": "Display name shown in chat and leaderboard" },
        "role": { "type": "string", "enum": ["owner", "moderator", "user", "guest"] },
        "avatarUrl": { "type": "string" },
        "warningsCount": { "type": "number" },
        "isRestrictedAdmin": { "type": "boolean" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "username", "displayName", "role"]
    },
    "CommunityChannel": {
      "title": "CommunityChannel",
      "description": "Trading discussion or signals channel with membership and visibility settings.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "password": { "type": "string" },
        "isOpenPublic": { "type": "boolean" },
        "isPrivate": { "type": "boolean" },
        "visibility": { "type": "string", "enum": ["public", "visible", "hidden"] },
        "allowedMemberIds": { "type": "array" },
        "memberIds": { "type": "array" },
        "imageUrl": { "type": "string" },
        "storagePath": { "type": "string" },
        "displayMemberCount": { "type": "number" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "name", "visibility"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Channel message with optional attachments and reactions.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "channelId": { "type": "string" },
        "senderId": { "type": "number" },
        "senderName": { "type": "string" },
        "senderRole": { "type": "string" },
        "isVirtualPersona": { "type": "boolean" },
        "virtualPersonaLabel": { "type": "string" },
        "text": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "channelId", "senderId", "timestamp"]
    },
    "PrivateMessage": {
      "title": "PrivateMessage",
      "description": "Direct 1-to-1 private chat message.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "conversationId": { "type": "string" },
        "senderId": { "type": "number" },
        "receiverId": { "type": "number" },
        "text": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "senderId", "receiverId", "timestamp"]
    },
    "UserChallenge": {
      "title": "UserChallenge",
      "description": "User 150-milestone trading challenge progress and trades.",
      "type": "object",
      "properties": {
        "userId": { "type": "number" },
        "username": { "type": "string" },
        "updatedAt": { "type": "number" }
      },
      "required": ["userId"]
    },
    "AppUpdate": {
      "title": "AppUpdate",
      "description": "Android APK release metadata for in-app updates.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "versionCode": { "type": "number" },
        "versionName": { "type": "string" },
        "downloadUrl": { "type": "string" }
      },
      "required": ["versionCode", "versionName"]
    },
    "AiAssistantThread": {
      "title": "AiAssistantThread",
      "description": "Owner-exclusive AI assistant session context and active section/channel state.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "ownerId": { "type": "number" },
        "ownerUsername": { "type": "string", "maxLength": 32 },
        "activeSection": { "type": "string", "maxLength": 64 },
        "activeChannelId": { "type": "string", "maxLength": 128 },
        "activeChannelName": { "type": "string", "maxLength": 200 },
        "activePartnerId": { "type": "number" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "ownerId", "ownerUsername", "createdAt", "updatedAt"]
    },
    "AiAssistantMessage": {
      "title": "AiAssistantMessage",
      "description": "Private chat message between Owner Salim and the AI Assistant.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "threadId": { "type": "string", "maxLength": 128 },
        "ownerId": { "type": "number" },
        "ownerUsername": { "type": "string", "maxLength": 32 },
        "role": { "type": "string", "enum": ["user", "assistant"] },
        "text": { "type": "string", "maxLength": 20000 },
        "draftId": { "type": "string", "maxLength": 128 },
        "pendingActionId": { "type": "string", "maxLength": 128 },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "threadId", "ownerId", "ownerUsername", "role", "text", "timestamp"]
    },
    "AiAssistantDraft": {
      "title": "AiAssistantDraft",
      "description": "Drafted virtual persona channel interactions awaiting Owner Salim approval or scheduled staggered publishing.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "ownerId": { "type": "number" },
        "ownerUsername": { "type": "string", "maxLength": 32 },
        "channelId": { "type": "string", "maxLength": 128 },
        "channelName": { "type": "string", "maxLength": 200 },
        "topic": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "enum": ["pending_approval", "publishing", "published", "cancelled"] },
        "items": { "type": "array" },
        "intervalSeconds": { "type": "number" },
        "nextPublishAt": { "type": "number" },
        "publishedCount": { "type": "number" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "ownerId", "ownerUsername", "channelId", "status", "items", "createdAt", "updatedAt"]
    },
    "AiAssistantPendingAction": {
      "title": "AiAssistantPendingAction",
      "description": "Sensitive administrative or broadcast action awaiting explicit Owner Salim confirmation.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "ownerId": { "type": "number" },
        "ownerUsername": { "type": "string", "maxLength": 32 },
        "actionType": { "type": "string", "maxLength": 64 },
        "titleAr": { "type": "string", "maxLength": 300 },
        "summaryAr": { "type": "string", "maxLength": 2000 },
        "status": { "type": "string", "enum": ["pending", "executed", "cancelled"] },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "ownerId", "ownerUsername", "actionType", "titleAr", "summaryAr", "status", "createdAt", "updatedAt"]
    },
    "AiAssistantAuditLog": {
      "title": "AiAssistantAuditLog",
      "description": "Immutable audit trail of commands and administrative actions executed by the AI Assistant.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "ownerId": { "type": "number" },
        "ownerUsername": { "type": "string", "maxLength": 32 },
        "actionType": { "type": "string", "maxLength": 64 },
        "command": { "type": "string", "maxLength": 1000 },
        "target": { "type": "string", "maxLength": 300 },
        "status": { "type": "string", "enum": ["success", "pending", "cancelled", "error"] },
        "details": { "type": "string", "maxLength": 2000 },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "ownerId", "ownerUsername", "actionType", "status", "timestamp"]
    },
    "PushOutboxJob": {
      "title": "PushOutboxJob",
      "description": "Server-side persistent retry queue for failed or deferred FCM/WebPush deliveries.",
      "type": "object",
      "properties": {
        "jobId": { "type": "string" },
        "userId": { "type": "number" },
        "platform": { "type": "string" },
        "attempts": { "type": "number" },
        "nextAttemptAt": { "type": "number" },
        "createdAt": { "type": "number" }
      },
      "required": ["jobId", "userId", "platform", "createdAt"]
    },
    "PushPrefs": {
      "title": "PushPrefs",
      "description": "Per-user mute and push notification channel preferences.",
      "type": "object",
      "properties": {
        "userId": { "type": "number" },
        "mutedAll": { "type": "boolean" },
        "mutedChannels": { "type": "array" },
        "mutedPartners": { "type": "array" },
        "updatedAt": { "type": "number" }
      },
      "required": ["userId", "updatedAt"]
    }
  },
  "firestore": {
    "/community_users/{userId}": {
      "schema": { "$ref": "#/entities/CommunityUser" },
      "description": "Canonical user accounts synced across Web and Android APK clients."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/CommunityUser" },
      "description": "Server-side user records mirror."
    },
    "/community_channels/{channelId}": {
      "schema": { "$ref": "#/entities/CommunityChannel" },
      "description": "Canonical trading channels and member access lists."
    },
    "/channels/{channelId}": {
      "schema": { "$ref": "#/entities/CommunityChannel" },
      "description": "Server-side channel records mirror."
    },
    "/chat_messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Channel chat messages."
    },
    "/private_messages/{messageId}": {
      "schema": { "$ref": "#/entities/PrivateMessage" },
      "description": "Direct messages between users."
    },
    "/user_challenges/{userId}": {
      "schema": { "$ref": "#/entities/UserChallenge" },
      "description": "Trading challenge progress per user."
    },
    "/app_updates/{docId}": {
      "schema": { "$ref": "#/entities/AppUpdate" },
      "description": "Published APK update metadata."
    },
    "/ai_assistant_threads/{threadId}": {
      "schema": { "$ref": "#/entities/AiAssistantThread" },
      "description": "Owner-exclusive AI Assistant conversation context."
    },
    "/ai_assistant_messages/{messageId}": {
      "schema": { "$ref": "#/entities/AiAssistantMessage" },
      "description": "Owner-exclusive AI Assistant private chat history."
    },
    "/ai_assistant_drafts/{draftId}": {
      "schema": { "$ref": "#/entities/AiAssistantDraft" },
      "description": "Virtual persona interaction batches pending Owner approval."
    },
    "/ai_assistant_pending_actions/{actionId}": {
      "schema": { "$ref": "#/entities/AiAssistantPendingAction" },
      "description": "Sensitive administrative operations pending Owner confirmation."
    },
    "/ai_assistant_audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AiAssistantAuditLog" },
      "description": "Immutable audit log of AI Assistant commands and operations."
    },
    "/push_outbox/{jobId}": {
      "schema": { "$ref": "#/entities/PushOutboxJob" },
      "description": "Server-side persistent push notification retry outbox."
    },
    "/push_prefs/{prefId}": {
      "schema": { "$ref": "#/entities/PushPrefs" },
      "description": "Server-side persistent user mute and notification preferences."
    }
  }
}
