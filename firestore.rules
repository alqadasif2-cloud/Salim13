rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Users & Community Profiles
    match /users/{userId} {
      allow read, write: if true;
    }

    match /community_users/{userId} {
      allow read, write: if true;
    }

    // 2. Channels & Discussion Rooms
    match /channels/{channelId} {
      allow read, write: if true;

      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    match /community_channels/{channelId} {
      allow read, write: if true;

      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // 3. Flat Public Chat Messages
    match /chat_messages/{messageId} {
      allow read, write: if true;
    }

    // 4. Private Messages & 1-on-1 Direct Chats
    match /private_messages/{messageId} {
      allow read, write: if true;
    }

    match /private_conversations/{pairKey} {
      allow read, write: if true;

      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // 5. Challenges & Milestone Stations
    match /challenges/{challengeId} {
      allow read, write: if true;

      match /trades/{tradeId} {
        allow read, write: if true;
      }
    }

    match /user_challenges/{userId} {
      allow read, write: if true;

      match /trades/{tradeId} {
        allow read, write: if true;
      }
    }

    // 6. Subscriptions, Plans & Consents
    match /subscription_plans/{planId} {
      allow read, write: if true;
    }

    match /subscription_audit_logs/{logId} {
      allow read, write: if true;
    }

    match /subscription_consents/{consentId} {
      allow read, write: if true;
    }

    // 7. Guests, Counters & Support Config
    match /guest_identities/{id} {
      allow read, write: if true;
    }

    match /counters/{id} {
      allow read, write: if true;
    }

    match /guest_support_config/{id} {
      allow read, write: if true;
    }

    // 8. Notifications & FCM Device Tokens
    match /community_notifications/{docId} {
      allow read, write: if true;
    }

    match /notifications/{docId} {
      allow read, write: if true;
    }

    // 9. Warnings & Moderation Reports
    match /user_warnings/{warningId} {
      allow read, write: if true;
    }

    // 10. Media Files & Storage Attachments
    match /media_files/{fileId} {
      allow read, write: if true;
    }

    // 11. Application Updates & Release Metadata
    match /app_updates/{docId} {
      allow read, write: if true;
    }

    // 12. System Health
    match /_system_health/{docId} {
      allow read, write: if true;
    }

    // 13. Owner-Exclusive AI Assistant Collections (Server-Verified Owner ID 1 / "Salim")
    function isValidAiId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isMainOwnerData(data) {
      return data.ownerId is int
        && data.ownerId == 1
        && data.ownerUsername is string
        && data.ownerUsername == 'Salim';
    }

    function isValidAiThread(data) {
      return data.keys().hasAll(['id', 'ownerId', 'ownerUsername', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'ownerId', 'ownerUsername', 'activeSection',
          'activeChannelId', 'activeChannelName', 'activePartnerId',
          'createdAt', 'updatedAt'
        ])
        && isValidAiId(data.id)
        && isMainOwnerData(data)
        && data.createdAt is number
        && data.updatedAt is number
        && (!('activeSection' in data) || data.activeSection == null || (data.activeSection is string && data.activeSection.size() <= 64))
        && (!('activeChannelId' in data) || data.activeChannelId == null || (data.activeChannelId is string && data.activeChannelId.size() <= 128))
        && (!('activeChannelName' in data) || data.activeChannelName == null || (data.activeChannelName is string && data.activeChannelName.size() <= 200))
        && (!('activePartnerId' in data) || data.activePartnerId == null || data.activePartnerId is number);
    }

    function isValidAiMessage(data) {
      return data.keys().hasAll(['id', 'threadId', 'ownerId', 'ownerUsername', 'role', 'text', 'timestamp'])
        && data.keys().hasOnly([
          'id', 'threadId', 'ownerId', 'ownerUsername', 'role', 'text',
          'toolSteps', 'draftId', 'pendingActionId', 'navigation', 'timestamp'
        ])
        && isValidAiId(data.id)
        && isValidAiId(data.threadId)
        && isMainOwnerData(data)
        && data.role in ['user', 'assistant']
        && data.text is string && data.text.size() <= 20000
        && data.timestamp is number
        && (!('toolSteps' in data) || data.toolSteps == null || (data.toolSteps is list && data.toolSteps.size() <= 25))
        && (!('draftId' in data) || data.draftId == null || (data.draftId is string && data.draftId.size() <= 128))
        && (!('pendingActionId' in data) || data.pendingActionId == null || (data.pendingActionId is string && data.pendingActionId.size() <= 128))
        && (!('navigation' in data) || data.navigation == null || data.navigation is map);
    }

    function isValidAiDraft(data) {
      return data.keys().hasAll(['id', 'ownerId', 'ownerUsername', 'channelId', 'channelName', 'topic', 'status', 'items', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'ownerId', 'ownerUsername', 'channelId', 'channelName',
          'topic', 'status', 'items', 'intervalSeconds', 'nextPublishAt',
          'publishedCount', 'createdAt', 'updatedAt'
        ])
        && isValidAiId(data.id)
        && isMainOwnerData(data)
        && data.channelId is string && data.channelId.size() >= 1 && data.channelId.size() <= 128
        && data.channelName is string && data.channelName.size() <= 200
        && data.topic is string && data.topic.size() <= 1000
        && data.status in ['pending_approval', 'publishing', 'published', 'cancelled']
        && data.items is list && data.items.size() <= 50
        && (!('intervalSeconds' in data) || (data.intervalSeconds is number && data.intervalSeconds >= 0 && data.intervalSeconds <= 3600))
        && (!('nextPublishAt' in data) || data.nextPublishAt == null || data.nextPublishAt is number)
        && (!('publishedCount' in data) || data.publishedCount is number)
        && data.createdAt is number
        && data.updatedAt is number;
    }

    function isValidAiPendingAction(data) {
      return data.keys().hasAll(['id', 'ownerId', 'ownerUsername', 'actionType', 'titleAr', 'summaryAr', 'payload', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'ownerId', 'ownerUsername', 'actionType', 'titleAr',
          'summaryAr', 'payload', 'status', 'resultMessage', 'createdAt', 'updatedAt'
        ])
        && isValidAiId(data.id)
        && isMainOwnerData(data)
        && data.actionType is string && data.actionType.size() <= 64
        && data.titleAr is string && data.titleAr.size() <= 300
        && data.summaryAr is string && data.summaryAr.size() <= 2000
        && data.payload is map
        && data.status in ['pending', 'executed', 'cancelled']
        && (!('resultMessage' in data) || data.resultMessage == null || (data.resultMessage is string && data.resultMessage.size() <= 2000))
        && data.createdAt is number
        && data.updatedAt is number;
    }

    function isValidAiAuditLog(data) {
      return data.keys().hasAll(['id', 'ownerId', 'ownerUsername', 'actionType', 'command', 'target', 'status', 'details', 'timestamp'])
        && data.keys().hasOnly([
          'id', 'ownerId', 'ownerUsername', 'actionType', 'command',
          'target', 'status', 'details', 'timestamp'
        ])
        && isValidAiId(data.id)
        && isMainOwnerData(data)
        && data.actionType is string && data.actionType.size() <= 64
        && data.command is string && data.command.size() <= 1000
        && data.target is string && data.target.size() <= 300
        && data.status in ['success', 'pending', 'cancelled', 'error']
        && data.details is string && data.details.size() <= 2000
        && data.timestamp is number;
    }

    match /ai_assistant_threads/{threadId} {
      allow get: if isValidAiId(threadId) && (resource == null || resource.data.ownerId == 1);
      allow list: if resource.data.ownerId == 1;
      allow create: if isValidAiId(threadId) && isValidAiThread(request.resource.data);
      allow update: if isValidAiId(threadId)
        && isValidAiThread(request.resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    match /ai_assistant_messages/{messageId} {
      allow get: if isValidAiId(messageId) && (resource == null || resource.data.ownerId == 1);
      allow list: if resource.data.ownerId == 1;
      allow create: if isValidAiId(messageId) && isValidAiMessage(request.resource.data);
      allow update: if isValidAiId(messageId)
        && isValidAiMessage(request.resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.timestamp == resource.data.timestamp;
      allow delete: if isValidAiId(messageId) && resource.data.ownerId == 1;
    }

    match /ai_assistant_drafts/{draftId} {
      allow get: if isValidAiId(draftId) && (resource == null || resource.data.ownerId == 1);
      allow list: if resource.data.ownerId == 1;
      allow create: if isValidAiId(draftId) && isValidAiDraft(request.resource.data);
      allow update: if isValidAiId(draftId)
        && isValidAiDraft(request.resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    match /ai_assistant_pending_actions/{actionId} {
      allow get: if isValidAiId(actionId) && (resource == null || resource.data.ownerId == 1);
      allow list: if resource.data.ownerId == 1;
      allow create: if isValidAiId(actionId) && isValidAiPendingAction(request.resource.data);
      allow update: if isValidAiId(actionId)
        && isValidAiPendingAction(request.resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    match /ai_assistant_audit_logs/{logId} {
      allow get: if isValidAiId(logId) && (resource == null || resource.data.ownerId == 1);
      allow list: if resource.data.ownerId == 1;
      allow create: if isValidAiId(logId) && isValidAiAuditLog(request.resource.data);
      allow update, delete: if false;
    }

    // 14. Server-Only Secrets & Internal Push Delivery Queues (Admin/ADC SDK only)
    match /_server_secrets/{docId} {
      allow read, write: if false;
    }

    match /push_outbox/{jobId} {
      allow read, write: if false;
    }

    match /push_prefs/{prefId} {
      allow read, write: if false;
    }

    // 15. Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
